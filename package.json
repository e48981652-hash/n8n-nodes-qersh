{
	"name": "@qersh/n8n-nodes-qersh",
	"version": "0.1.0",
	"description": "n8n community node for Qersh (Qersh Pay): receive signed wallet-transfer notifications (Vodafone Cash, Orange Cash, e& money, InstaPay) from the merchant's phone, verify them, match them to orders and reply from your workflow.",
	"license": "MIT",
	"homepage": "https://qersh.cfd/en/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"qersh",
		"vodafone cash",
		"instapay",
		"orange cash",
		"egypt",
		"wallet",
		"webhook"
	],
	"author": {
		"name": "Qersh Pay",
		"email": "e48981652@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/qersh-pay/n8n-nodes-qersh.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"check:core": "node scripts/check-core.mjs",
		"check:wording": "node scripts/check-wording.mjs",
		"scan:check": "node scripts/scan-check.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/QershWebhookApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Qersh/QershTrigger.node.js",
			"dist/nodes/Qersh/Qersh.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@n8n/scan-community-package": "*",
		"@types/node": "^22.20.5",
		"eslint": "9.29.0",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"vitest": "^5.0.5",
		"vitest-mock-extended": "^5.1.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
